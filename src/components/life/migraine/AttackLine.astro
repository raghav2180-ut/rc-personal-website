---
import { duration, fmtDuration, fmtTime, painBand, type Day } from '../../../lib/life/migraine';
import { shortDay, dayMonth } from '../../../lib/life/dates';

interface Props {
  day: Day;
}
const { day } = Astro.props;
const dur = day.ongoing ? 'still going' : fmtDuration(duration(day));
const med = day.medTaken
  ? `${day.dose ? `${day.dose} ` : ''}${day.medName}${day.relief ? ` · relief: ${day.relief.toLowerCase()}` : ''}`
  : 'No medicine';
---
<div class="att">
  <span class="pdot" data-pain={painBand(day.pain)} aria-label={`Pain ${day.pain ?? 'not set'} of 10`}>{day.pain ?? '?'}</span>
  <div>
    <b>{shortDay(day.date)} {dayMonth(day.date).split(' ')[1]} · {fmtTime(day.start)} · {dur}</b>
    <span>{med}</span>
  </div>
</div>
