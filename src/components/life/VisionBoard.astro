---
/** A vision board: one picture per line, each with an optional family photo and an editor. */
import { PHOTOS, type BoardName, type Tile } from '../../lib/life/visionboard';

interface Props {
  board: BoardName;
  tiles: Tile[];
  here: string;
  title?: string;
}
const { board, tiles, here, title = 'Vision board' } = Astro.props;
const free = board === '2029';
const photoUrl = (k: string) => `/api/life/photo/${k}.jpg`;
const sized = (u: string, w: number) => (/images\.unsplash\.com|plus\.unsplash\.com/.test(u) && !/[?&]w=/.test(u) ? `${u}${u.includes('?') ? '&' : '?'}auto=format&fit=crop&w=${w}&q=70` : u);
const label = (k: string) => PHOTOS.find((p) => p.key === k)?.label ?? '';
const anchor = `board-${board}`;
// Group photos sit in a wider frame so faces stay visible.
const GROUPS = new Set(['couple', 'family', 'parents', 'papa-harshit']);
---
<section class="vb" aria-labelledby={`${anchor}-h`} id={anchor}>
  <div class="vb-head">
    <h2 id={`${anchor}-h`}>{title}</h2>
    <span class="mono muted">{tiles.filter((t) => t.image || t.photo).length} OF {tiles.length} WITH PICTURES</span>
  </div>
  {tiles.length === 0 && <p class="muted" style="margin:0">{free ? 'No pictures yet. Add the first one below.' : 'Add lines above and each one gets a picture here.'}</p>}
  <div class="vb-grid">
    {tiles.map((t, i) => {
      const main = t.image ? sized(t.image, i === 0 ? 1400 : 800) : t.photo ? photoUrl(t.photo) : '';
      const inset = t.image && t.photo ? photoUrl(t.photo) : '';
      return (
        <figure class:list={['vb-tile', { feature: i === 0 && tiles.length > 3, empty: !main, done: t.done, 'is-photo': !t.image && !!t.photo }]}>
          <div class="vb-pic">
            {main ? <img src={main} alt={t.caption} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" /> : <span class="vb-ph">Add a picture</span>}
            {inset && <img class:list={['vb-face', { group: GROUPS.has(t.photo) }]} src={inset} alt={label(t.photo)} loading="lazy" />}
            {t.done && <span class="vb-done">DONE ✓</span>}
          </div>
          <figcaption>{t.caption}</figcaption>
          <details class="vb-edit" data-busy>
            <summary>{main ? 'Edit picture' : 'Add picture'}</summary>
            <form method="post" action="/api/life/visionboard" data-enhance class="vb-form">
              <input type="hidden" name="action" value="save" />
              <input type="hidden" name="id" value={t.id} />
              <input type="hidden" name="board" value={board} />
              <input type="hidden" name="item" value={t.item} />
              <input type="hidden" name="next" value={`${here}#${anchor}`} />
              {free && <label class="label sm">Caption<input class="field" name="caption" value={t.caption} maxlength="300" required /></label>}
              <label class="label sm">Picture link
                <input class="field" name="image" value={t.image} maxlength="1000" placeholder="https://… (right-click a picture, Copy image address)" inputmode="url" />
              </label>
              <label class="label sm">Family photo
                <select class="field" name="photo">
                  <option value="">None</option>
                  {PHOTOS.map((p) => <option value={p.key} selected={p.key === t.photo}>{p.label}</option>)}
                </select>
              </label>
              <div class="vb-actions">
                <button class="btn" type="submit">Save</button>
              </div>
            </form>
            {free && t.id && (
              <div class="lv-tools">
                {['up', 'down'].map((dir) => (
                  <form method="post" action="/api/life/visionboard" data-enhance>
                    <input type="hidden" name="action" value={dir} /><input type="hidden" name="id" value={t.id} /><input type="hidden" name="next" value={`${here}#${anchor}`} />
                    <button type="submit" class="link-btn" disabled={(dir === 'up' && i === 0) || (dir === 'down' && i === tiles.length - 1)}>{dir === 'up' ? '← Earlier' : 'Later →'}</button>
                  </form>
                ))}
                <form method="post" action="/api/life/visionboard" data-enhance>
                  <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={t.id} /><input type="hidden" name="next" value={`${here}#${anchor}`} />
                  <button type="submit" class="link-btn danger">Remove</button>
                </form>
              </div>
            )}
          </details>
        </figure>
      );
    })}
  </div>
  {free && (
    <details class="vb-add" data-busy>
      <summary class="btn-dashed" style="display:inline-flex;align-items:center">+ Add a picture</summary>
      <form method="post" action="/api/life/visionboard" data-enhance class="vb-form card tight">
        <input type="hidden" name="action" value="save" /><input type="hidden" name="board" value={board} /><input type="hidden" name="id" value="" /><input type="hidden" name="item" value="" />
        <input type="hidden" name="next" value={`${here}#${anchor}`} />
        <label class="label sm">Caption<input class="field" name="caption" maxlength="300" required placeholder="e.g. Our 4BHK in Delhi NCR" /></label>
        <label class="label sm">Picture link<input class="field" name="image" maxlength="1000" placeholder="https://…" inputmode="url" /></label>
        <label class="label sm">Family photo
          <select class="field" name="photo"><option value="">None</option>{PHOTOS.map((p) => <option value={p.key}>{p.label}</option>)}</select>
        </label>
        <div class="vb-actions"><button class="btn" type="submit">Add</button></div>
      </form>
    </details>
  )}
  <p class="vb-credit muted">Stock photos from Unsplash. Family photos are private to this platform.</p>
</section>
