---
import { FY_GOALS, type Top3Item } from '../../lib/life/data';
import Top3Toggle from './Top3Toggle.astro';

interface Props {
  items: Top3Item[];
  date: string;
  person: string;
  next: string;
  doneCount: number;
  mainCount: number;
}
const { items, date, person, next, doneCount, mainCount } = Astro.props;
const addLabel = mainCount >= 3 ? '+ Add a bonus task' : '+ Add a task';
---
<section class="card" aria-labelledby="top3h" data-busy>
  <div class="card-head">
    <h2 id="top3h">Top 3</h2>
    <span class="mono muted" style="font-size:13px">{mainCount ? `${doneCount} OF ${mainCount} DONE` : 'NOT SET YET'}</span>
  </div>
  <p class="sub">Tap the box to update: done, then partly done, then not done, then clear.</p>

  {items.length === 0 && <p class="empty">No Top 3 for this day yet. Add the three things that matter most.</p>}

  {items.map((item) => {
    const done = item.done === 'Yes';
    const part = item.done === 'Partial';
    const notDone = item.done === 'No';
    return (
      <div class:list={['t3-item', { done, notdone: notDone }]}>
        <Top3Toggle row={item.row} task={item.task} status={item.done} date={date} person={person} next={next} />
        <div class="t3-body">
          <div class="t3-meta">
            <span class="mono muted" style="font-size:12px">#{item.n}{item.bonus ? ' · BONUS' : ''}</span>
            {item.fy && <span class="pill">{item.fy.toUpperCase()}</span>}
          </div>
          <p class="t3-text">{item.task.replace(/\s*\(bonus\)\s*$/i, '')}</p>
          <details class="t3-edit" id={`edit-${item.row}`}>
            <summary aria-label={`Edit "${item.task}"`}>Edit</summary>
            <form method="post" action="/api/life/top3" data-enhance>
              <input type="hidden" name="action" value="edit" />
              <input type="hidden" name="row" value={item.row} />
              <input type="hidden" name="date" value={date} />
              <input type="hidden" name="person" value={person} />
              <input type="hidden" name="next" value={next} />
              <label class="label t">Task
                <textarea class="field" name="task" required maxlength="300" rows="2">{item.task.replace(/\s*\(bonus\)\s*$/i, '')}</textarea>
              </label>
              <label class="label fy">FY goal
                <select class="field" name="fy">
                  <option value="">None</option>
                  {item.fy && !FY_GOALS.includes(item.fy) && <option selected>{item.fy}</option>}
                  {FY_GOALS.map((g) => <option selected={g === item.fy}>{g}</option>)}
                </select>
              </label>
              <label class="label st">Status
                <select class="field" name="status">
                  <option value="" selected={item.done === ''}>Not marked</option>
                  <option value="Yes" selected={item.done === 'Yes'}>Done</option>
                  <option value="Partial" selected={item.done === 'Partial'}>Partly done</option>
                  <option value="No" selected={item.done === 'No'}>Not done</option>
                </select>
              </label>
              <div class="t3-edit-actions">
                <button type="submit" class="btn">Save</button>
                <button type="button" class="link-btn" data-close-edit>Cancel</button>
              </div>
            </form>
          </details>
        </div>
        {done && <span class="stamp">DONE</span>}
        {part && <span class="stamp part">PART</span>}
        {notDone && <span class="stamp no">NOT DONE</span>}
      </div>
    );
  })}

  <div class="t3-add">
    <details>
      <summary class="btn-dashed" style="display:inline-flex;align-items:center">{addLabel}</summary>
      <form method="post" action="/api/life/top3" data-enhance>
        <input type="hidden" name="action" value="add" />
        <input type="hidden" name="date" value={date} />
        <input type="hidden" name="person" value={person} />
        <input type="hidden" name="next" value={next} />
        <label class="label">Task
          <input class="field" name="task" required maxlength="300" placeholder="What needs doing?" />
        </label>
        <label class="label fy">FY goal
          <select class="field" name="fy">
            <option value="">None</option>
            {FY_GOALS.map((g) => <option>{g}</option>)}
          </select>
        </label>
        <button type="submit" class="btn">Add</button>
      </form>
    </details>
  </div>
</section>

<script>
  // Cancel closes the edit panel. Uses delegation so it keeps working after the
  // page swaps in fresh content following a save.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-close-edit]');
    const details = btn?.closest('details');
    if (details) details.open = false;
  });
</script>
