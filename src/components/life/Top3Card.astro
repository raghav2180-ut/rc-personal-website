---
import { FY_GOALS, type Top3Item } from '../../lib/life/data';

interface Props {
  items: Top3Item[];
  date: string;
  person: string;
  next: string;
  doneCount: number;
  mainCount: number;
}
const { items, date, person, next, doneCount, mainCount } = Astro.props;
const addLabel = mainCount >= 3 ? '+ Add a bonus task' : '+ Add a task';
---
<section class="card" aria-labelledby="top3h" data-busy>
  <div class="card-head">
    <h2 id="top3h">Top 3</h2>
    <span class="mono muted" style="font-size:13px">{mainCount ? `${doneCount} OF ${mainCount} DONE` : 'NOT SET YET'}</span>
  </div>
  <p class="sub">Picked from Trello Today in the morning. Tap the box when it's done.</p>

  {items.length === 0 && <p class="empty">No Top 3 for this day yet. Add the three things that matter most.</p>}

  {items.map((item) => {
    const done = item.done === 'Yes';
    const part = item.done === 'Partial';
    return (
      <div class:list={['t3-item', { done }]}>
        <form method="post" action="/api/life/top3" data-enhance>
          <input type="hidden" name="row" value={item.row} />
          <input type="hidden" name="date" value={date} />
          <input type="hidden" name="person" value={person} />
          <input type="hidden" name="done" value={done ? 'No' : 'Yes'} />
          <input type="hidden" name="next" value={next} />
          <button
            type="submit"
            class:list={['t3-box', { done, part }]}
            aria-pressed={done ? 'true' : 'false'}
            aria-label={done ? `Mark "${item.task}" not done` : `Mark "${item.task}" done`}
          >
            {done && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            )}
          </button>
        </form>
        <div class="t3-body">
          <div class="t3-meta">
            <span class="mono muted" style="font-size:12px">#{item.n}{item.bonus ? ' · BONUS' : ''}</span>
            {item.fy && <span class="pill">{item.fy.toUpperCase()}</span>}
          </div>
          <p class="t3-text">{item.task.replace(/\s*\(bonus\)\s*$/i, '')}</p>
        </div>
        {done && <span class="stamp">DONE</span>}
        {part && <span class="stamp part">PART</span>}
      </div>
    );
  })}

  <div class="t3-add">
    <details>
      <summary class="btn-dashed" style="display:inline-flex;align-items:center">{addLabel}</summary>
      <form method="post" action="/api/life/top3" data-enhance>
        <input type="hidden" name="action" value="add" />
        <input type="hidden" name="date" value={date} />
        <input type="hidden" name="person" value={person} />
        <input type="hidden" name="next" value={next} />
        <label class="label">Task
          <input class="field" name="task" required maxlength="300" placeholder="What needs doing?" />
        </label>
        <label class="label fy">FY goal
          <select class="field" name="fy">
            <option value="">None</option>
            {FY_GOALS.map((g) => <option>{g}</option>)}
          </select>
        </label>
        <button type="submit" class="btn">Add</button>
      </form>
    </details>
  </div>
</section>
