---
/**
 * A photo, optimised at build time (AVIF + WebP, several widths).
 * `frame` gives it the white polaroid border used across the site;
 * `tilt` rotates it slightly, as if pinned to the page.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  frame?: boolean;
  tilt?: number;
  ratio?: string;            // e.g. "4 / 5"
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  frame = false,
  tilt = 0,
  ratio,
  sizes = '(min-width: 1024px) 420px, 90vw',
  widths = [360, 560, 800, 1200],
  eager = false,
  class: className = '',
} = Astro.props;

const frameClass = frame ? 'bg-paper p-2 pb-2 shadow-[0_6px_18px_rgba(23,32,51,0.16)]' : '';
const tiltStyle = tilt ? `transform: rotate(${tilt}deg);` : '';
const ratioStyle = ratio ? `aspect-ratio: ${ratio};` : '';
---
<figure class={`m-0 ${frameClass} ${className}`} style={tiltStyle}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="block w-full h-auto object-cover"
    style={ratioStyle}
  />
  {caption && (
    <figcaption class={frame ? 'font-hand text-[1.05rem] leading-snug text-pen px-1 pt-2' : 'text-sm text-muted pt-2'}>
      {caption}
    </figcaption>
  )}
</figure>
