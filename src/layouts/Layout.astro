---
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'Raghav Chopra · Founder, UnsaidTalks',
  description = person.oneLiner,
  path = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL('/og.jpg', Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'Founder & CEO',
  worksFor: { '@type': 'Organization', name: 'UnsaidTalks Education', url: person.links.unsaidtalks },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Thapar Institute of Engineering and Technology' },
  url: Astro.site?.toString(),
  image: ogImage,
  description: person.description,
  sameAs: [person.links.linkedin, person.links.instagram, person.links.unsaidtalks],
};

const nav = [
  { href: '/#rounds', label: 'The rounds' },
  { href: '/#tips', label: 'Tips for juniors' },
  { href: '/#people', label: 'People' },
  { href: '/#unsaidtalks', label: 'UnsaidTalks' },
  { href: '/writing/', label: 'Writing' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F3F5F9" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raghav Chopra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:bg-paper focus:px-3 focus:py-2 focus:z-50">Skip to content</a>

    <header class="mx-auto max-w-6xl px-4 sm:px-6 pt-6 pb-2">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 font-mono text-[0.8rem]">
        <a href="/" class="no-underline text-ink font-medium">
          chopraraghav.com<span class="hidden sm:inline text-muted"> / interview-experiences /</span><span class="hidden sm:inline"> raghav-chopra</span>
        </a>
        <nav aria-label="Main">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 list-none m-0 p-0">
            {nav.map((item) => (
              <li><a href={item.href} class="no-underline hover:underline">{item.label}</a></li>
            ))}
            <li><a href="/#contact" class="no-underline font-medium text-stamp hover:text-stamp">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-rule">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-1">
          <p class="m-0 font-display text-xl font-bold">Unfold success from untold experiences.</p>
          <p class="m-0 text-sm text-muted">The UnsaidTalks tagline, and the reason for this site.</p>
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.8rem]">
          <a href={person.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          <a href={person.links.instagram} rel="me noopener" target="_blank">Instagram</a>
          <a href={person.links.unsaidtalks} rel="noopener" target="_blank">unsaidtalks.com</a>
          <span class="text-muted">© {new Date().getFullYear()} Raghav Chopra</span>
        </div>
      </div>
    </footer>
  </body>
</html>
