---
import '../styles/global.css';
import { person } from '../data/site';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'Raghav Chopra · Founder, UnsaidTalks',
  description = person.oneLiner,
  path = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL('/og.jpg', Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'Founder & CEO',
  worksFor: { '@type': 'Organization', name: 'UnsaidTalks Education', url: person.links.unsaidtalks },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Thapar Institute of Engineering and Technology' },
  url: Astro.site?.toString(),
  image: ogImage,
  description: person.description,
  sameAs: [person.links.linkedin, person.links.instagram, person.links.unsaidtalks],
};

const nav = [
  { href: '/#rounds', label: 'The rounds' },
  { href: '/#tips', label: 'Tips for juniors' },
  { href: '/#people', label: 'People' },
  { href: '/#unsaidtalks', label: 'UnsaidTalks' },
  { href: '/writing/', label: 'Writing' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F3F5F9" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raghav Chopra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen">
    <Analytics />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:bg-paper focus:px-3 focus:py-2 focus:z-50">Skip to content</a>

    <header class="sticky top-0 z-40 backdrop-blur-md bg-desk/85 border-b border-rule/60 transition-all duration-300">
      <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10 py-3.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 font-mono text-[0.82rem]">
        <a href="/" class="no-underline text-ink font-semibold flex items-center gap-2.5 group">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-gradient-to-r from-orange-500 to-amber-500 shadow-xs"></span>
          </span>
          <span class="uppercase text-[0.95rem] tracking-wide font-extrabold text-orange-600 group-hover:text-orange-500 transition-colors">RaghavChopra</span>
        </a>
        <nav aria-label="Main">
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 list-none m-0 p-0">
            {nav.map((item) => (
              <li><a href={item.href} class="no-underline text-muted hover:text-orange-600 font-medium nav-link-animated py-1">{item.label}</a></li>
            ))}
            <li>
              <a href="/#contact" class="no-underline font-semibold bg-gradient-to-r from-orange-500 to-amber-600 text-ink px-4 py-1.5 rounded-full hover:shadow-lg hover:shadow-orange-500/30 hover:scale-105 active:scale-95 transition-all duration-200 inline-block">Contact</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-rule">
      <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-10 py-10 flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-1">
          <p class="m-0 font-display text-xl font-bold">Unfold success from untold experiences.</p>
          <p class="m-0 text-sm text-muted">The UnsaidTalks tagline, and the reason for this site.</p>
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.8rem]">
          <a href={person.links.linkedin} rel="me noopener" target="_blank" class="hover:text-orange-600 transition-colors">LinkedIn</a>
          <a href={person.links.instagram} rel="me noopener" target="_blank" class="hover:text-orange-600 transition-colors">Instagram</a>
          <a href={person.links.unsaidtalks} rel="noopener" target="_blank" class="hover:text-orange-600 transition-colors">unsaidtalks.com</a>
          <span class="text-muted">© {new Date().getFullYear()} Raghav Chopra</span>
        </div>
      </div>
    </footer>

    <button
      id="back-to-top"
      type="button"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-gradient-to-r from-orange-500 to-amber-600 text-ink shadow-lg shadow-orange-500/30 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:scale-110 hover:shadow-xl hover:shadow-orange-500/50 active:scale-95 cursor-pointer font-bold text-lg"
    >
      ↑
    </button>
    <script>
      const topBtn = document.getElementById('back-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          topBtn?.classList.remove('opacity-0', 'pointer-events-none');
          topBtn?.classList.add('opacity-100');
        } else {
          topBtn?.classList.add('opacity-0', 'pointer-events-none');
          topBtn?.classList.remove('opacity-100');
        }
      });
      topBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
