---
import '../styles/global.css';
import '../styles/life.css';
import type { Flash } from '../lib/life/page';
import { env } from '../lib/life/env';

interface Props {
  title: string;
  active?: 'today' | 'week' | 'goals' | 'monthly' | 'vision';
  name?: string;
  flash?: Flash | null;
  href?: (path: string) => string;
  bare?: boolean;
}

const { title, active, name, flash, href = (p: string) => p, bare = false } = Astro.props;
const sheetId = env('SHEET_ID');
const sheetUrl = sheetId ? `https://docs.google.com/spreadsheets/d/${sheetId}/edit` : 'https://docs.google.com/spreadsheets/';
const yearsLeft = Math.max(0, 2029 - new Date().getFullYear());

const links = [
  { key: 'today', n: '01', label: 'Today', path: '/life' },
  { key: 'week', n: '02', label: 'Week', path: '/life/week' },
  { key: 'goals', n: '03', label: 'Goals', path: '/life/goals' },
  { key: 'monthly', n: '04', label: 'Monthly', path: '/life/monthly' },
  { key: 'vision', n: '05', label: 'Vision 2029', path: '/life/vision' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#172033" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Dream Life 2029</title>
  </head>
  <body class="life">
    {bare ? (
      <slot />
    ) : (
      <div class="l-shell">
        <nav class="lnav" aria-label="Tracker">
          <input type="checkbox" id="lnav-toggle" class="lnav-toggle sr-only" aria-label="Show menu" />
          <div class="lnav-top">
            <a class="lnav-brand" href={href('/life')}>
              <b>Dream Life</b>
              <span>2029 · {yearsLeft} {yearsLeft === 1 ? 'YEAR' : 'YEARS'} TO GO</span>
            </a>
            <label for="lnav-toggle" class="lnav-burger" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </label>
          </div>
          <div class="lnav-links">
            {links.map((l) => (
              <a href={href(l.path)} aria-current={active === l.key ? 'page' : undefined}>
                <span>{l.n}</span>{l.label}
              </a>
            ))}
          </div>
          <div class="lnav-foot">
            <span>Signed in as {name}</span>
            <a class="mono sheet" href={sheetUrl} target="_blank" rel="noopener">Data: Dream Life 2029 – Tracker ↗</a>
            <form method="post" action="/api/auth/signout"><button type="submit">Sign out</button></form>
          </div>
        </nav>
        <main class="l-main" id="main" data-life-main>
          <slot />
        </main>
      </div>
    )}

    <div id="toast-slot" aria-live="polite">
      {flash && (
        <div class:list={['toast', { err: flash.kind === 'err' }]} role={flash.kind === 'err' ? 'alert' : 'status'}>
          {flash.kind === 'ok' && <span class="mono">SAVED</span>}
          {flash.text}
        </div>
      )}
    </div>

    <script>
      // Progressive enhancement: submit tracker forms in the background and swap
      // in the fresh page, so the screen doesn't jump. Without JS the forms
      // still work as normal POST + redirect.
      const clean = (url: string) => {
        const u = new URL(url);
        u.searchParams.delete('saved');
        u.searchParams.delete('error');
        return u.pathname + u.search + u.hash;
      };
      if (location.search.includes('saved=') || location.search.includes('error=')) {
        history.replaceState(null, '', clean(location.href));
      }

      document.addEventListener('submit', async (event) => {
        const form = event.target as HTMLFormElement;
        if (!form.matches('form[data-enhance]')) return;
        event.preventDefault();
        const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
        const body = new FormData(form, submitter ?? undefined);
        const block = (form.closest('[data-busy]') as HTMLElement) ?? form;
        block.classList.add('busy');
        try {
          const res = await fetch(form.getAttribute('action') ?? location.pathname, { method: 'POST', body, credentials: 'same-origin' });
          if (!res.ok) throw new Error(String(res.status));
          if (new URL(res.url).pathname.startsWith('/life/login')) {
            location.href = res.url;
            return;
          }
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const fresh = doc.querySelector('[data-life-main]');
          const current = document.querySelector('[data-life-main]');
          if (fresh && current) current.replaceWith(fresh);
          else {
            const phone = doc.querySelector('[data-phone]');
            const here = document.querySelector('[data-phone]');
            if (phone && here) here.replaceWith(phone);
          }
          const toast = doc.getElementById('toast-slot');
          const slot = document.getElementById('toast-slot');
          if (toast && slot) slot.replaceWith(toast);
          history.replaceState(null, '', clean(res.url));
        } catch {
          // Fall back to a normal submit.
          block.classList.remove('busy');
          HTMLFormElement.prototype.submit.call(form);
        }
      });
    </script>
  </body>
</html>
