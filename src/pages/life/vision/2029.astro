---
import LifeLayout from '../../../layouts/LifeLayout.astro';
import Problem from '../../../components/life/Problem.astro';
import VisionTabs from '../../../components/life/VisionTabs.astro';
import { loadVision, SCORE_AREAS } from '../../../lib/life/data';
import { addDays, dayMonth, todayIST, weekday } from '../../../lib/life/dates';
import { errorMessage, lifeContext } from '../../../lib/life/page';
import VisionBoard from '../../../components/life/VisionBoard.astro';
import { loadBoard, type Tile } from '../../../lib/life/visionboard';

export const prerender = false;

const { me, person, flash, href, here } = lifeContext(Astro);
const today = todayIST();

let data: Awaited<ReturnType<typeof loadVision>> | null = null;
let tiles: Tile[] = [];
let problem = '';
try {
  data = await loadVision(person, today);
  tiles = await loadBoard(person, '2029');
} catch (err) {
  problem = errorMessage(err);
}

// Next Saturday review, for the scores label.
const daysToSat = (6 - weekday(today) + 7) % 7;
const nextSat = addDays(today, daysToSat);
const streakClass = (s: { sunday: boolean; value: string }) => (s.sunday ? 's' : s.value === 'Yes' ? 'y' : s.value === 'No' ? 'n' : '');
const streakWord = (s: { sunday: boolean; value: string; hasCheckIn: boolean }) =>
  s.sunday ? 'Sunday' : s.value === 'Yes' ? 'read' : s.value === 'No' ? 'missed' : 'no check-in';
---
<LifeLayout title="Vision 2029" active="vision" name={me} flash={flash} href={href}>
  <header class="l-head">
    <div>
      <span class="eyebrow">OCTOBER 2029 · READ IT EVERY MORNING</span>
      <h1>Life Vision</h1>
    </div>
  </header>
  <VisionTabs active="2029" href={href} />

  {problem && <Problem message={problem} />}

  {data && (
    <div class="l-row">
      <article class="card vision-text" aria-label="Vision">
        {data.text.length ? data.text.map((p) => <p>{p}</p>) : (
          <p class="muted" style="font-size:17px">Your 2029 vision isn't written yet. Use Edit below to write it, and it will show here every morning.</p>
        )}
        <p class="q">{data.question}</p>
        <details class="lv-edit v29-edit" data-busy>
          <summary>Edit</summary>
          <form method="post" action="/api/life/lifevision" data-enhance class="stack-sm">
            <input type="hidden" name="action" value="vision2029" />
            <input type="hidden" name="next" value={here} />
            <label class="label">Your 2029 vision. Leave a blank line between paragraphs.
              <textarea class="field" name="body" rows="14" maxlength="12000" required>{data.text.join('\n\n')}</textarea>
            </label>
            <label class="label">Today's question
              <input class="field" name="question" maxlength="500" value={data.question} />
            </label>
            <div class="rv-foot"><button class="btn" type="submit">Save vision</button></div>
          </form>
        </details>
      </article>

      <aside class="l-col-1" style="flex:2 1 340px">
        {data.board.length > 0 && (
          <section class="card tight" aria-labelledby="sbh" data-busy>
            <div class="card-head" style="margin-bottom:6px">
              <h2 id="sbh" style="font-size:20px">Today → 2029</h2>
              <span class="mono muted" style="font-size:11px">FROM THE SHEET</span>
            </div>
            {data.board.map((b) => (
              <div class="board-row">
                <span>{b.label}</span>
                {b.now ? (
                  <span class="now">{b.now}</span>
                ) : (
                  <details class="add-now">
                    <summary>ADD</summary>
                    <form method="post" action="/api/life/vision" data-enhance>
                      <input type="hidden" name="row" value={b.row} />
                      <input type="hidden" name="next" value={here} />
                      <input name="value" required maxlength="60" aria-label={`${b.label} today`} />
                      <button type="submit">Save</button>
                    </form>
                  </details>
                )}
                <span class="arrow" aria-hidden="true">→</span>
                <span class="tgt">{b.target}</span>
              </div>
            ))}
          </section>
        )}

        <section class="card tight stack-sm" aria-labelledby="lsh">
          <div class="card-head">
            <h2 id="lsh" style="font-size:20px">Life scores</h2>
            <span class="mono muted" style="font-size:11px">
              {data.lastScores ? `${dayMonth(data.lastScores.date).toUpperCase()} · ` : ''}NEXT SAT {dayMonth(nextSat).toUpperCase()}
            </span>
          </div>
          {data.lastScores ? (
            SCORE_AREAS.map((area, i) => {
              const v = data!.lastScores!.values[i];
              return (
                <div class="score-row">
                  <span>{area}</span>
                  <div class="meter" role="img" aria-label={`${area} ${v ?? 'not scored'} out of 10`}>
                    <i class:list={{ low: (v ?? 0) < 6 }} style={`width:${(v ?? 0) * 10}%`}></i>
                  </div>
                  <span class="mono">{v ?? '–'}</span>
                </div>
              );
            })
          ) : (
            <p class="muted" style="margin:0">No scores yet. Add them in the <a href={href('/life/week') + '#review'}>Saturday review</a>.</p>
          )}
        </section>

        <section class="card tight stack-sm" aria-labelledby="mvh">
          <div class="card-head">
            <h2 id="mvh" style="font-size:20px">Morning vision</h2>
            <span class="mono" style="font-size:12px;color:var(--color-stamp);font-weight:600">{data.streakYes} OF {data.streakDays} WORK DAYS</span>
          </div>
          <div class="streak">
            {data.streak.map((s) => (
              <div>
                <i class={streakClass(s)} role="img" aria-label={`${dayMonth(s.date)}: ${streakWord(s)}`}></i>
                <span>{Number(s.date.slice(8))}</span>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>
  )}
  {data && <VisionBoard board="2029" tiles={tiles} here={here} title="Vision board 2029" />}
</LifeLayout>
