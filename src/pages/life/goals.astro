---
import LifeLayout from '../../layouts/LifeLayout.astro';
import Problem from '../../components/life/Problem.astro';
import GoalSetup from '../../components/life/GoalSetup.astro';
import { daysBetween, isIso } from '../../lib/life/dates';
import { fmt, loadGoalsPage, longDay, milestones, monthsLabel, pace, pct, periodLabel, type Goal, type Table } from '../../lib/life/goals';
import { errorMessage, lifeContext } from '../../lib/life/page';

export const prerender = false;

const { me, flash, href, here } = lifeContext(Astro);

let data: Awaited<ReturnType<typeof loadGoalsPage>> | null = null;
let problem = '';
try {
  // Local testing only: ?today=2027-03-20 shows the page as of that date.
  const asOf = import.meta.env.DEV ? Astro.url.searchParams.get('today') : null;
  data = await loadGoalsPage(me, isIso(asOf) ? asOf : undefined);
} catch (err) {
  problem = errorMessage(err);
}

const today = data?.today ?? '';
const fy = data?.fy ?? null;
const quarter = data?.quarter ?? null;
const fyDays = data ? Math.max(0, daysBetween(today, data.fyKey.end)) : 0;
const qDays = data ? Math.max(0, daysBetween(today, data.qKey.end)) : 0;
const steps = (g: Goal, t: Table) => milestones(g.milestones, t);
const nextStep = (g: Goal, t: Table) => steps(g, t).find((m) => !m.done);
const dueText = (d: string | null) => {
  if (!d) return '';
  const n = daysBetween(today, d);
  return n < 0 ? `${longDay(d).replace(/ \d{4}$/, '')} · ${-n} days late` : n === 0 ? 'Today' : `${longDay(d).replace(/ \d{4}$/, '')} · ${n} days`;
};
const result = (t: Table) => t.goals.filter((g) => g.target !== null).map((g) => `${g.area} ${fmt(g, g.current ?? 0)}/${fmt(g, g.target)}`).join(' · ');
const width = (g: Goal) => Math.min(100, Math.max(0, pct(g) ?? 0));
---
<LifeLayout title="Goals" active="goals" name={me} flash={flash} href={href}>
  <header class="l-head">
    <div>
      <span class="eyebrow">{data ? `${periodLabel(data.fyKey)} · DEADLINE ${longDay(data.fyKey.end).toUpperCase()} · ` : ''}<span class="hot">{fyDays} DAYS LEFT</span></span>
      <h1>{me === 'Kajol' ? 'Your goals' : 'Goals'}</h1>
    </div>
  </header>

  {problem && <Problem message={problem} />}

  {data && (
    <>
      {data.prompts.map((p) => (
        <details class="card gs-banner" open={p.urgent}>
          <summary>
            <span class="eyebrow" style="color:var(--color-stamp)">{p.why.toUpperCase()}</span>
            <b>Set {p.label} goals · {p.months}</b>
            <span class="btn">Set goals</span>
          </summary>
          <GoalSetup me={me} kind={p.kind} fy={p.fy} q={p.q} label={p.label} rows={p.rows} blanks={p.rows.length ? 1 : 4} here={here} />
        </details>
      ))}

      <!-- FY goals -->
      {fy && fy.goals.length > 0 && (
        <section class="stack" aria-labelledby="fyh">
          <div class="g-head">
            <h2 id="fyh">{periodLabel(fy)} goals</h2>
            <span class="mono muted">BY {longDay(fy.end).toUpperCase()}</span>
          </div>
          <div class="g-cards">
            {fy.goals.map((g) => {
              const p = pct(g);
              const nx = nextStep(g, fy);
              const numeric = g.target !== null;
              return (
                <section class="card g-card" aria-label={g.area}>
                  <div class="g-top"><span class="mono">{g.area}</span><span class="muted">{g.owner}</span></div>
                  <h3>{g.goal}</h3>
                  {numeric ? (
                    <>
                      <div class="g-nums"><b>{fmt(g, g.current)}</b><span>/ {fmt(g, g.target)}</span>{p !== null && <i>{p}%</i>}</div>
                      <div class="meter" role="img" aria-label={`${p ?? 0}% of target`}><i class:list={{ hi: (p ?? 0) >= 60 }} style={`width:${width(g)}%`}></i></div>
                      <p class="g-pace">{pace(g, fy, today)}</p>
                      {nx && <p class="g-next"><span class="cp-k">Next</span> {nx.text}</p>}
                    </>
                  ) : (
                    <ul class="g-steps">
                      {steps(g, fy).map((m, i) => (
                        <li class:list={{ done: m.done, late: !m.done && m.due !== null && m.due < today }}>
                          <form method="post" action="/api/life/goals" data-enhance>
                            <input type="hidden" name="action" value="milestone" />
                            <input type="hidden" name="row" value={g.row} />
                            <input type="hidden" name="goal" value={g.goal} />
                            <input type="hidden" name="i" value={i} />
                            <input type="hidden" name="next" value={here} />
                            <button type="submit" class="g-tick" aria-label={m.done ? `Mark not done: ${m.text}` : `Mark done: ${m.text}`}>{m.done ? '✓' : ''}</button>
                          </form>
                          <span>{m.text}{m.due && !m.done && <small>{dueText(m.due)}</small>}</span>
                        </li>
                      ))}
                      {steps(g, fy).length === 0 && <li class="muted">No steps yet. Add them in the sheet, separated by “;”.</li>}
                    </ul>
                  )}
                  {(numeric || g.revenue || g.notes) && (
                  <div class="g-actions">
                    {numeric && (
                      <details class="g-update">
                        <summary>Update</summary>
                        <form method="post" action="/api/life/goals" data-enhance class="g-form">
                          <input type="hidden" name="action" value="current" />
                          <input type="hidden" name="row" value={g.row} />
                          <input type="hidden" name="goal" value={g.goal} />
                          <input type="hidden" name="next" value={here} />
                          <label class="label sm">Current<input class="field" name="value" inputmode="decimal" value={g.current ?? ''} /></label>
                          <button class="btn" type="submit">Save</button>
                        </form>
                      </details>
                    )}
                    {(numeric ? g.milestones : '') || g.revenue || g.notes ? (
                      <details class="g-more">
                        <summary>Details</summary>
                        <dl>
                          {numeric && g.milestones && <><dt>MILESTONES</dt><dd>{g.milestones}</dd></>}
                          {g.baseline !== null && <><dt>BASELINE</dt><dd>{fmt(g, g.baseline)}</dd></>}
                          {g.revenue && <><dt>REVENUE</dt><dd>{g.revenue}</dd></>}
                          {g.notes && <><dt>NOTES</dt><dd>{g.notes}</dd></>}
                        </dl>
                      </details>
                    ) : null}
                  </div>
                  )}
                </section>
              );
            })}
          </div>
          <details class="g-add">
            <summary class="btn-dashed" style="display:inline-flex;align-items:center">+ Add a goal</summary>
            <GoalSetup me={me} kind="FY" fy={fy.fy} q={null} label={periodLabel(fy)} rows={[]} blanks={1} here={here} submit="Add goal" />
          </details>
        </section>
      )}

      <!-- This quarter -->
      {quarter && quarter.goals.length > 0 && (
        <section class="card stack-sm" aria-labelledby="qh">
          <div class="g-head">
            <h2 id="qh">This quarter · {periodLabel(quarter)}</h2>
            <span class="mono muted">{monthsLabel(quarter).toUpperCase()} · {qDays} DAYS LEFT</span>
          </div>
          {quarter.goals.map((g) => {
            const p = pct(g);
            return (
              <div class="q-row">
                <div class="q-goal"><span class="mono">{g.area}</span><span>{g.goal}</span></div>
                {g.target !== null ? (
                  <>
                    <div class="q-num"><b>{fmt(g, g.current ?? 0)}</b> / {fmt(g, g.target)}</div>
                    <div class="meter" role="img" aria-label={`${p ?? 0}% of target`}><i class:list={{ hi: (p ?? 0) >= 60 }} style={`width:${width(g)}%`}></i></div>
                    <span class="q-pace">{pace({ ...g, current: g.current ?? 0 }, quarter, today)}</span>
                    <details class="g-update">
                      <summary>Update</summary>
                      <form method="post" action="/api/life/goals" data-enhance class="g-form">
                        <input type="hidden" name="action" value="current" />
                        <input type="hidden" name="row" value={g.row} />
                        <input type="hidden" name="goal" value={g.goal} />
                        <input type="hidden" name="next" value={here} />
                        <label class="label sm">Current<input class="field" name="value" inputmode="decimal" value={g.current ?? ''} /></label>
                        <button class="btn" type="submit">Save</button>
                      </form>
                    </details>
                  </>
                ) : <span class="muted q-pace">{nextStep(g, quarter)?.text ?? ''}</span>}
              </div>
            );
          })}
          <details class="g-add">
            <summary class="btn-dashed" style="display:inline-flex;align-items:center">+ Add a {periodLabel(quarter)} goal</summary>
            <GoalSetup me={me} kind="Q" fy={quarter.fy} q={quarter.q} label={periodLabel(quarter)} rows={[]} blanks={1} here={here} submit="Add goal" />
          </details>
        </section>
      )}

      {(data.pastQuarters.length > 0 || data.lastFy) && (
        <section class="card tight stack-sm" aria-labelledby="ph">
          <h2 id="ph" style="font-size:18px">Past results</h2>
          {data.lastFy && <p class="g-past"><b>{periodLabel(data.lastFy)}</b> {result(data.lastFy)}</p>}
          {data.pastQuarters.map((t) => <p class="g-past"><b>{periodLabel(t)}</b> {result(t) || 'No numbers'}</p>)}
        </section>
      )}

      {!fy?.goals.length && !data.prompts.length && (
        <section class="card"><p class="muted" style="margin:0">No goals yet for {periodLabel(data.fyKey)}.</p></section>
      )}
    </>
  )}
</LifeLayout>
