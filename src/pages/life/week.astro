---
import LifeLayout from '../../layouts/LifeLayout.astro';
import Problem from '../../components/life/Problem.astro';
import SaturdayReview from '../../components/life/SaturdayReview.astro';
import { loadReview } from '../../lib/life/review';
import { FY_GOALS, loadWeek, STATUSES, WEEKLY_CAP } from '../../lib/life/data';
import { addDays, dayMonth, isIso, isoWeek, monthName, parts, shortDay, todayIST, weekStart } from '../../lib/life/dates';
import { errorMessage, lifeContext } from '../../lib/life/page';

export const prerender = false;

const { me, person, flash, href, here } = lifeContext(Astro);
const today = todayIST();
const thisWeek = weekStart(today);
const asked = Astro.url.searchParams.get('w');
const week = isIso(asked) ? weekStart(asked) : thisWeek;
const isThisWeek = week === thisWeek;

let data: Awaited<ReturnType<typeof loadWeek>> | null = null;
let problem = '';
try {
  data = await loadWeek(person, week);
} catch (err) {
  problem = errorMessage(err);
}

// The Saturday review is for this week or a past one, never a week still to come.
let review: Awaited<ReturnType<typeof loadReview>> | null = null;
let reviewProblem = '';
if (data && week <= thisWeek) {
  try {
    review = await loadReview(person, week);
  } catch (err) {
    reviewProblem = errorMessage(err);
  }
}

const sat = addDays(week, 5);
const ps = parts(week);
const pe = parts(sat);
const range =
  ps.month === pe.month
    ? `MON ${ps.day} – SAT ${pe.day} ${monthName(pe.month)} ${pe.year}`
    : `MON ${ps.day} ${monthName(ps.month)} – SAT ${pe.day} ${monthName(pe.month)} ${pe.year}`;
const prevWeek = addDays(week, -7);
const nextWeek = addDays(week, 7);
const weekLink = (w: string) => href('/life/week', w === thisWeek ? {} : { w });
const nextStatus = (s: string) => STATUSES[(STATUSES.indexOf(s as (typeof STATUSES)[number]) + 1) % STATUSES.length];

const goals = data?.summary.goals ?? [];
const capCount = goals.length;
const cellClass = (v: string) => (v === 'Yes' ? 'sq y' : v === 'No' ? 'sq n' : 'sq');
const word = (v: string) => (v === 'Yes' ? 'yes' : v === 'No' ? 'no' : 'not yet');
---
<LifeLayout title="Week" active="week" name={me} flash={flash} href={href}>
  <header class="l-head">
    <div>
      <span class="eyebrow">WEEK {isoWeek(week)} · {range}</span>
      <h1>{isThisWeek ? 'This week' : week > thisWeek ? 'Next week' : `Week of ${dayMonth(week)}`}</h1>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
      <a class="btn-ghost" href={weekLink(prevWeek)} aria-label="Previous week">← {dayMonth(prevWeek)}</a>
      <a class="btn-ghost" href={weekLink(nextWeek)} aria-label="Next week" aria-disabled={nextWeek > addDays(thisWeek, 7) ? 'true' : undefined}>{dayMonth(nextWeek)} →</a>
    </div>
  </header>

  {problem && <Problem message={problem} />}

  {data && (
    <>
      <div class="l-row">
        <section class="card l-col-2" style="display:block" aria-labelledby="wgh" data-busy>
          <div class="card-head" style="align-items:center">
            <h2 id="wgh">Weekly goals</h2>
            <div class="cap">
              <div aria-hidden="true" style="display:flex;gap:4px">
                {Array.from({ length: WEEKLY_CAP }, (_, i) => (
                  <i class:list={{ on: i < capCount && !(capCount >= WEEKLY_CAP && i === WEEKLY_CAP - 1), last: capCount >= WEEKLY_CAP && i === WEEKLY_CAP - 1 }} />
                ))}
              </div>
              <span class:list={['mono', { full: capCount >= WEEKLY_CAP }]}>
                {capCount} OF {WEEKLY_CAP}{capCount >= WEEKLY_CAP ? ' · AT THE CAP' : ''}
              </span>
            </div>
          </div>
          <p class="sub">3 to 5 goals a week, each tied to an FY goal. Tap a status to move it on.</p>

          {goals.length === 0 && <p class="empty">No goals for this week yet.</p>}

          {goals.map((g, i) => (
            <div class="wg" id={`goal-${i + 1}`}>
              <span class="n">{i + 1}</span>
              <div class="body">
                <span class="area">{g.fy || 'No FY goal'}</span>
                <span class="goal">{g.goal}</span>
                {(g.day || g.firstStep || g.priority) && (
                  <span class="remark">{g.priority && <b class="mono">{g.priority.toUpperCase()} · </b>}{g.day && `${shortDay(g.day)} deep work`}{g.day && g.firstStep && ' · '}{g.firstStep && `First step: ${g.firstStep}`}</span>
                )}
                {g.remarks && <span class="remark">{g.remarks}</span>}
              </div>
              <form method="post" action="/api/life/weekly" data-enhance>
                <input type="hidden" name="row" value={g.row} />
                <input type="hidden" name="week" value={week} />
                <input type="hidden" name="person" value={person} />
                <input type="hidden" name="status" value={nextStatus(g.status)} />
                <input type="hidden" name="next" value={`${here}#goal-${i + 1}`} />
                <button type="submit" class="status" data-s={g.status} aria-label={`Status: ${g.status}. Change to ${nextStatus(g.status)}`}>{g.status}</button>
              </form>
            </div>
          ))}

          {capCount < WEEKLY_CAP && (
            <div class="t3-add">
              <details>
                <summary class="btn-dashed" style="display:inline-flex;align-items:center">+ Add a goal ({WEEKLY_CAP - capCount} left)</summary>
                <form method="post" action="/api/life/weekly" data-enhance class="next-slot" style="margin-top:12px;align-items:flex-end">
                  <input type="hidden" name="action" value="add" />
                  <input type="hidden" name="week" value={week} />
                  <input type="hidden" name="person" value={person} />
                  <input type="hidden" name="next" value={here} />
                  <label class="label fy">FY goal
                    <select class="field" name="fy"><option value="">Pick one</option>{FY_GOALS.map((f) => <option>{f}</option>)}</select>
                  </label>
                  <label class="label g">Goal
                    <input class="field" name="goal" required maxlength="300" />
                  </label>
                  <button class="btn" type="submit">Add</button>
                </form>
              </details>
            </div>
          )}
        </section>

        <section class="card tight l-col-1 stack-sm" aria-labelledby="dsh">
          <h2 id="dsh">Day by day</h2>
          <div class="days">
            <span></span>
            {data.summary.days.map((d) => <a class:list={['dh', { today: d.date === today }]} href={href('/life', d.date === today ? {} : { d: d.date })}>{shortDay(d.date).toUpperCase()}</a>)}
            <span class="muted">Top 3</span>
            {data.summary.days.map((d) => <span class:list={['t3', { none: !d.top3Total }]}>{d.top3Total ? `${d.top3Done}/${d.top3Total}` : '–'}</span>)}
            <span class="muted">Vision</span>
            {data.summary.days.map((d) => <span class={cellClass(d.vision)} role="img" aria-label={`${shortDay(d.date)} vision ${word(d.vision)}`}></span>)}
            <span class="muted">Walk</span>
            {data.summary.days.map((d) => <span class={cellClass(d.walk)} role="img" aria-label={`${shortDay(d.date)} walk ${word(d.walk)}`}></span>)}
            <span class="muted">Deep</span>
            {data.summary.days.map((d) => <span class={cellClass(d.deep)} role="img" aria-label={`${shortDay(d.date)} deep work ${word(d.deep)}`}></span>)}
          </div>
          <div class="legend">
            <span><i class="sq y"></i>Yes</span>
            <span><i class="sq n"></i>No</span>
            <span><i class="sq"></i>Not yet</span>
          </div>
        </section>
      </div>

      {data.trend.length > 0 && (
        <section class="card stack" aria-labelledby="trend">
          <div class="card-head">
            <h2 id="trend" style="font-size:20px">Weekly goals fully done</h2>
            <span class="mono muted" style="font-size:12px">LAST {data.trend.length} WEEKS WITH GOALS{data.average !== null ? ` · ${data.year} AVERAGE ${data.average}%` : ''}</span>
          </div>
          <div class="trend-wrap">
            <div class="trend bars" style={`--cols:${data.trend.length}`}>
              {data.trend.map((t) => (
                <div class="bar">
                  <span class="mono">{t.pct}%</span>
                  <i class:list={{ hi: t.pct >= 50 }} style={`height:${Math.max(t.pct * 1.8, 3)}px`} title={`${t.total} goals`}></i>
                </div>
              ))}
            </div>
            <div class="trend labels" style={`--cols:${data.trend.length}`}>
              {data.trend.map((t) => <span>{dayMonth(t.week)}</span>)}
            </div>
          </div>
          {data.typicalGoals !== null && (
            <p class="hand" style="margin:0;font-size:19px">Most weeks had about {data.typicalGoals} goals. Fewer goals, more of them finished.</p>
          )}
        </section>
      )}

      {review ? <SaturdayReview data={review} here={here} /> : reviewProblem && <Problem message={reviewProblem} />}
    </>
  )}
</LifeLayout>

