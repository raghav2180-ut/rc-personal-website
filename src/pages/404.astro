---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found · Raghav Chopra">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-16">
    <div class="bg-paper border border-rule px-6 py-12 sm:px-12 flex flex-col gap-5">
      <p class="m-0 font-mono text-[0.8rem] text-muted">ROUND 404</p>
      <h1 class="m-0 text-[2.6rem] font-extrabold leading-tight">This page didn’t make it past the written test.</h1>
      <p class="m-0">The link may be old or mistyped. The rest of the story is still here.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/" class="no-underline bg-ink text-paper hover:text-paper hover:bg-pen font-display font-semibold px-5 py-3">Back to the start</a>
        <a href="/writing/" class="no-underline border-[1.5px] border-ink text-ink hover:text-pen hover:border-pen font-display font-semibold px-5 py-3">Read the writing</a>
      </div>
    </div>
  </section>
</Layout>
