# Private Life Tracker (/life). Set these in Vercel → Settings → Environment Variables.
# Never commit real values: this repo is public.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The whole service-account JSON key, pasted as one value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Dream Life 2029 – Tracker sheet ID (share the sheet with the service account as Editor).
SHEET_ID=
ALLOWED_EMAILS=raghav@unsaidtalks.com,kajol@unsaidtalks.com
# Any long random string, e.g. from `openssl rand -base64 32`.
AUTH_SECRET=

# Migraine Diary (/life/migraine): its own Google Sheet, shared with the same
# service account as Editor. The app adds the Days and Profile tabs itself.
MIGRAINE_SHEET_ID=
# Optional: who can open the Migraine Diary. Defaults to Raghav's email in ALLOWED_EMAILS.
# MIGRAINE_EMAILS=raghav@unsaidtalks.com

# Optional: link for the "Open board" button on Today.
TRELLO_BOARD_URL=

# Local only: point at a JSON copy of the sheet to develop without Google.
# LIFE_MOCK_FILE=/path/to/life-fixture.json
